---
import ReserveButton from './ReserveButton.astro';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<!--
  Satu mekanisme reservasi yang selalu tampil, per breakpoint:
  - Mobile (<900px): bar bawah (header mobile tidak menampilkan tombol CTA).
  - Desktop (≥900px): TIDAK ada floating pill — tombol "Reserve" di sticky header
    sudah selalu terlihat, jadi tidak perlu duplikat (menghindari CTA berlebihan).
-->
<div class="sticky-reserve-bar">
  <ReserveButton lang={lang} label={t.common.reserve} section="sticky" class="w-full" />
</div>

<style>
  .sticky-reserve-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-forest-950) 90%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(230,205,154,0.15);
  }
  @media (min-width: 900px) { .sticky-reserve-bar { display: none; } }
</style>
