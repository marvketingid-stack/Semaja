---
import Icon from './Icon.astro';
import { brand } from '@/data/site';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="location" class="section surface-ivory location">
  <div class="container-x location-grid">
    <div class="location-info reveal">
      <div class="location-head-row">
        <span class="index-num">04</span>
        <p class="eyebrow">{t.location.eyebrow}</p>
      </div>
      <h2 class="location-title">{t.location.title}</h2>

      <div class="loc-block">
        <div class="loc-icon"><Icon name="pin" class="w-5 h-5" /></div>
        <div>
          <h3 class="loc-label">{t.location.addressTitle}</h3>
          <p class="loc-text">{brand.address.street}<br />{brand.address.area}, {brand.address.city}</p>
        </div>
      </div>

      <div class="loc-block">
        <div class="loc-icon"><Icon name="clock" class="w-5 h-5" /></div>
        <div>
          <h3 class="loc-label">{t.location.hoursTitle}</h3>
          {brand.hours.map((h) => (
            <p class="loc-text"><span class="loc-day">{lang === 'en' ? h.dEn : h.d}</span> · {h.h}</p>
          ))}
        </div>
      </div>

      <a href={brand.mapsDirections} target="_blank" rel="noopener" class="btn btn-primary loc-cta"
         data-track="directions_click" data-section="location" data-cta-label="get_directions">
        <Icon name="pin" class="w-5 h-5" />
        <span>{t.location.directions}</span>
      </a>
    </div>

    <div class="location-map reveal">
      <iframe
        src={brand.mapsEmbed}
        title="Google Maps — Semaja"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location-grid { display: grid; gap: 2.4rem; align-items: center; }
  .location-head-row { display: flex; align-items: center; gap: 1.2rem; margin-bottom: 1.4rem; }
  .location-title { font-size: clamp(2.2rem, 5.4vw, 3.6rem); margin: 0 0 1.8rem; }
  .loc-block { display: flex; gap: 0.9rem; margin-bottom: 1.5rem; }
  .loc-icon { flex: none; width: 40px; height: 40px; border-radius: 999px; display: grid; place-items: center; background: rgba(182,134,59,0.14); color: var(--color-gold-600); }
  .loc-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-gold-600); margin-bottom: 0.4rem; }
  .loc-text { color: var(--color-ink-soft); font-size: 1rem; }
  .loc-day { color: var(--color-ink); }
  .loc-cta { margin-top: 0.6rem; }
  .location-map { border-radius: 2px; overflow: hidden; border: 1px solid rgba(28,25,18,0.14); box-shadow: 0 30px 60px -34px rgba(28,25,18,.4); }
  .location-map iframe { width: 100%; height: 340px; border: 0; display: block; filter: grayscale(0.2) contrast(1.05); }
  @media (min-width: 768px) {
    .location-grid { grid-template-columns: 1fr 1.1fr; gap: 4rem; }
    .location-map iframe { height: 440px; }
  }
</style>
