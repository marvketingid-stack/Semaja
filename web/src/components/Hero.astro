---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import heroImg from '@/assets/photos/ambience-3.jpg';
import { heroVideo } from '@/data/site';
import { useTranslations, homePath, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const posterUrl = heroImg.src;
---
<section class="hero" aria-label={`${t.hero.kicker} ${t.hero.headline}`}>
  <div class="hero-media">
    {heroVideo ? (
      <video
        class="hero-video"
        autoplay muted loop playsinline
        preload="metadata"
        poster={posterUrl}
        aria-hidden="true"
      >
        <source src={heroVideo} type="video/mp4" />
      </video>
    ) : (
      <Image
        src={heroImg}
        alt={lang === 'en' ? 'The warm dining room at Semaja, with woven wall art and rattan lighting' : 'Ruang makan hangat Semaja dengan tenun dinding dan lampu rotan'}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={72}
        class="hero-img"
      />
    )}
    <div class="hero-scrim"></div>
  </div>

  <div class="container-x hero-content">
    <p class="hero-kicker reveal">{t.hero.kicker}</p>
    <h1 class="hero-title reveal">{t.hero.headline}</h1>
    <p class="hero-sub reveal">{t.hero.sub}</p>
  </div>

  <a href={`${homePath(lang)}#story`} class="hero-scroll" aria-label={t.hero.scroll}>
    <Icon name="chevron" class="w-6 h-6" />
  </a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; }
  .hero-media { position: absolute; inset: 0; z-index: 0; }
  .hero-img, .hero-video { width: 100%; height: 100%; object-fit: cover; }
  .hero-scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 50% 45%, rgba(6,35,31,0.32), rgba(6,35,31,0.55) 70%, rgba(6,35,31,0.8) 100%),
      linear-gradient(to top, var(--color-forest-950) 2%, transparent 26%);
  }
  .hero-content { position: relative; z-index: 2; padding-block: 7rem; max-width: 62rem; }

  /* Baris kecil ber-spasi lebar (ala "Creating the") */
  .hero-kicker {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    font-size: clamp(0.8rem, 2.2vw, 1.25rem);
    font-weight: 400;
    color: var(--color-cream-100);
  }

  /* Kata besar italic serif (ala "Good Life") */
  .hero-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(3.6rem, 13vw, 8.5rem);
    line-height: 0.95;
    color: var(--color-cream-50);
    margin: clamp(0.6rem, 1.8vw, 1.4rem) 0 0;
    text-shadow: 0 2px 50px rgba(0,0,0,0.4);
  }

  .hero-sub {
    margin: clamp(1.6rem, 4vw, 2.4rem) auto 0;
    max-width: 44ch;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-cream-200);
  }

  .reveal:nth-child(2) { transition-delay: .08s; }
  .reveal:nth-child(3) { transition-delay: .18s; }

  .hero-scroll {
    position: absolute; bottom: calc(1.6rem + env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%);
    z-index: 2; display: flex; align-items: center; justify-content: center;
    color: var(--color-cream-100);
    animation: floaty 2.4s ease-in-out infinite;
  }
  @keyframes floaty { 0%,100% { transform: translate(-50%,0); } 50% { transform: translate(-50%,7px); } }
  /* Desktop: chevron disembunyikan karena nav duduk di dasar hero (lihat HeroNav). */
  @media (min-width: 900px) { .hero-scroll { display: none; } }
</style>
