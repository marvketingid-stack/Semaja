---
/**
 * Nav desktop ala ismaya.com: mulai di DASAR hero, lalu naik mengikuti scroll
 * dan menempel (sticky) di atas — tetap di sana sampai bawah halaman.
 * Ditempatkan tepat SETELAH <Hero> di dalam <main> (lihat Landing.astro).
 * Mobile pakai header + burger biasa (komponen ini disembunyikan < 900px).
 */
import ReserveButton from './ReserveButton.astro';
import { useTranslations, homePath, mainNav, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);
const nav = mainNav(lang);
---
<div class="hero-nav">
  <div class="container-x hero-nav-inner">
    <a href={home} class="hero-nav-brand font-display" aria-label="Semaja — beranda">SEMAJA</a>
    <nav class="hero-nav-links" aria-label="Utama">
      {nav.map((n) => <a href={n.href} class="hero-nav-link">{n.label}</a>)}
    </nav>
    <div class="hero-nav-cta"><ReserveButton lang={lang} label={t.nav.reserve} section="header" /></div>
  </div>
</div>

<style>
  .hero-nav { display: none; }
  @media (min-width: 900px) {
    .hero-nav {
      display: block; position: sticky; top: 0; z-index: 40;
      /* tarik ke atas supaya bar duduk di dasar hero saat di puncak halaman */
      margin-top: calc(-1 * (var(--header-h) + 2.2rem));
      background: transparent; border-bottom: 1px solid transparent;
      transition: background-color .35s ease, backdrop-filter .35s ease, border-color .35s ease;
    }
    .hero-nav.is-stuck {
      background: color-mix(in srgb, var(--color-forest-950) 90%, transparent);
      backdrop-filter: blur(12px);
      border-bottom-color: rgba(230, 205, 154, 0.14);
    }
    .hero-nav-inner { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); gap: 1rem; }
    .hero-nav-brand { font-size: 1.7rem; font-weight: 600; letter-spacing: 0.32em; text-indent: 0.32em; color: var(--color-gold-400); transition: opacity .3s ease; }
    /* Wordmark di bar hanya tampil saat sudah menempel di atas — di dasar hero
       wordmark yang dipakai adalah yang center (lihat Hero.astro), supaya tak dobel. */
    .hero-nav:not(.is-stuck) .hero-nav-brand { opacity: 0; visibility: hidden; }
    .hero-nav-links { display: flex; gap: 2rem; }
    .hero-nav-link { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--color-cream-100); opacity: 0.88; transition: color .2s, opacity .2s; text-shadow: 0 1px 12px rgba(0,0,0,.35); }
    .hero-nav-link:hover { color: var(--color-gold-400); opacity: 1; }
    .hero-nav:not(.is-stuck) .hero-nav-brand { text-shadow: 0 1px 16px rgba(0,0,0,.4); }
  }
</style>

<script>
  // Solid saat bar sudah menempel di atas (top === 0), transparan saat masih turun di area hero.
  const nav = document.querySelector('.hero-nav');
  if (nav) {
    let ticking = false;
    const update = () => {
      nav.classList.toggle('is-stuck', nav.getBoundingClientRect().top <= 0.5);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>
