---
import { Image } from 'astro:assets';
import { dishes } from '@/data/dishes';
import { useTranslations, homePath, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="menu" class="section surface-forest-alt dishes">
  <div class="container-x">
    <header class="dishes-head reveal">
      <div class="dishes-head-row">
        <span class="index-num">02</span>
        <p class="eyebrow">{t.dishes.eyebrow}</p>
      </div>
      <h2 class="dishes-title">{t.dishes.title}</h2>
      <p class="dishes-sub lede">{t.dishes.sub}</p>
    </header>

    <ol class="dish-list">
      {dishes.map((d, i) => (
        <li class="dish-row reveal">
          <div class="dish-media">
            <Image src={d.img} alt={d.name} widths={[420, 640, 860]} sizes="(min-width:768px) 46vw, 90vw" format="webp" quality={72} class="dish-img" />
            <span class="dish-num font-display">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="dish-info">
            <h3 class="dish-name">{d.name}</h3>
            <div class="rule-gold dish-rule"></div>
            <p class="dish-desc">{lang === 'en' ? d.descEn : d.descId}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="dishes-cta reveal">
      <a href={`${homePath(lang)}#location`} class="btn btn-ghost" data-track="cta_click" data-section="menu" data-cta-label="see_full_menu">
        {t.dishes.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .dishes-head { max-width: 46ch; }
  .dishes-head-row { display: flex; align-items: center; gap: 1.2rem; margin-bottom: 1.4rem; }
  .dishes-title { font-size: clamp(2.2rem, 5.6vw, 3.8rem); color: var(--color-cream-50); margin: 0 0 1rem; }
  .dishes-sub { color: var(--color-cream-200); }

  .dish-list { list-style: none; padding: 0; margin: clamp(2.6rem, 6vw, 4.5rem) 0 0; display: flex; flex-direction: column; gap: clamp(2.6rem, 6vw, 5rem); }
  .dish-row { display: grid; gap: 1.4rem; align-items: center; }
  .dish-media { position: relative; overflow: hidden; border-radius: 2px; }
  .dish-img { width: 100%; height: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform .7s var(--ease-out-soft); }
  .dish-row:hover .dish-img { transform: scale(1.04); }
  .dish-num {
    position: absolute; top: 0.7rem; left: 0.9rem;
    font-size: 2.2rem; font-weight: 500; color: var(--color-cream-50);
    text-shadow: 0 2px 18px rgba(0,0,0,.5); opacity: 0.9;
  }
  .dish-name { font-size: clamp(1.8rem, 4.4vw, 2.8rem); font-weight: 500; color: var(--color-gold-300); }
  .dish-rule { max-width: 120px; margin: 1rem 0; }
  .dish-desc { color: var(--color-cream-200); font-size: 1.05rem; font-weight: 300; max-width: 42ch; }

  .dishes-cta { margin-top: clamp(3rem, 7vw, 5rem); text-align: center; }

  @media (min-width: 768px) {
    .dish-row { grid-template-columns: 1.05fr 0.95fr; gap: clamp(2.5rem, 5vw, 4.5rem); }
    .dish-img { aspect-ratio: 5/4; }
    /* Selang-seling: baris genap → gambar di kanan */
    .dish-row:nth-child(even) .dish-media { order: 2; }
    .dish-row:nth-child(even) .dish-info { order: 1; }
    .dish-info { padding-inline: clamp(0.5rem, 2vw, 1.5rem); }
  }
</style>
