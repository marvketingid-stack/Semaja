---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { useTranslations } from '@/i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const posts = (await getCollection('articles', (e) => e.data.lang === 'en' && !e.data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<BaseLayout
  lang={lang}
  title={`${t.blog.title} — Semaja`}
  description={t.blog.sub}
  pathId="/articles"
  pathEn="/articles"
>
  <Header lang={lang} />
  <main id="main" class="blog-wrap">
    <div class="container-x">
      <header class="blog-head reveal">
        <h1 class="blog-title">{t.blog.title}</h1>
        <p class="blog-sub">{t.blog.sub}</p>
      </header>
      {posts.length === 0 ? (
        <p class="blog-empty">{t.blog.empty}</p>
      ) : (
        <div class="blog-grid">
          {posts.map((entry) => <ArticleCard entry={entry} lang={lang} />)}
        </div>
      )}
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .blog-wrap { padding-top: clamp(3rem, 8vw, 5rem); padding-bottom: clamp(4rem, 10vw, 7rem); }
  .blog-head { text-align: center; max-width: 44ch; margin: 0 auto 2.6rem; }
  .blog-title { font-size: clamp(2.2rem, 6vw, 3.4rem); color: var(--color-cream-50); }
  .blog-sub { margin-top: 0.6rem; color: var(--color-cream-200); }
  .blog-grid { display: grid; gap: 1.6rem; grid-template-columns: 1fr; }
  .blog-empty { text-align: center; color: var(--color-cream-200); padding: 3rem 0; }
  @media (min-width: 640px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
