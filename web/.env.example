# ============================================================
# Semaja — Environment Variables
# Salin file ini menjadi ".env" lalu isi nilainya.
# (Nilai diberikan terpisah oleh tim marketing — PRD 6.6)
# ============================================================

# Domain produksi final (dipakai untuk sitemap, canonical, hreflang, OG)
SITE_URL=https://semaja.id

# --- Kontak / Reservasi ---
# Nomor WhatsApp Business (format internasional, tanpa "+" atau spasi)
PUBLIC_WA_NUMBER=628000000000
PUBLIC_PHONE_DISPLAY=+62 800 0000 000

# --- Tracking (kosongkan jika belum siap; script tidak akan dipasang) ---
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_CLARITY_ID=

# Webhook untuk mengirim lead ke GoHighLevel saat klik reservasi (opsional, PRD 6.5)
PUBLIC_GHL_LEAD_WEBHOOK=
